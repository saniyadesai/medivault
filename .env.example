# ── Frontend (Vite) ──
# Backend origin for local dev. Leave EMPTY in production so the app uses relative /api URLs (Vercel rewrites).
VITE_API_BASE_URL=http://localhost:3001
# true = accounts live in browser localStorage and no backend/DB is needed (demo mode). Never set in production.
VITE_ENABLE_MOCK_AUTH=false

# ── Backend (Node/Express) ──
DATABASE_URL=postgresql://localhost:5432/medivault
# TLS is on automatically for non-localhost URLs (Neon etc.); set DATABASE_SSL=false/true to override.
SESSION_SECRET=replace-with-a-long-random-secret   # e.g. openssl rand -hex 32
API_PORT=3001
API_HOST=0.0.0.0
# Comma-separated list of allowed browser origins for CORS.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5177
NODE_ENV=development

# ── Object storage: any S3-compatible service. Local default is MinIO from docker-compose.yml ──
# docker compose reads S3_ACCESS_KEY / S3_SECRET_KEY from this file for the MinIO root user.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=medivault
S3_SECRET_KEY=medivault-secret          # MinIO requires at least 8 characters
S3_BUCKET=medivault-documents
S3_REGION=us-east-1

# ── AI summaries: any OpenAI-compatible chat completions API ──
# Local (free):   ollama pull qwen2.5vl:7b   then the values below
# OpenRouter:     AI_BASE_URL=https://openrouter.ai/api/v1  AI_MODEL=openai/gpt-4o  AI_API_KEY=sk-or-...
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=qwen2.5vl:7b
AI_API_KEY=
AI_TIMEOUT_MS=300000                    # local vision models are slow; 5 minutes

# ── Chat + RAG: text embeddings for retrieval (server/src/embeddings.js) ──
# A chat-completions endpoint doesn't necessarily also serve embeddings (e.g. OpenRouter
# doesn't), so this can point somewhere different from AI_BASE_URL. Requires pgvector
# (`CREATE EXTENSION vector;`) on Postgres — see db/migrations/0009_chat_and_rag.sql.
# Default here reuses the same Gemini key as AI_API_KEY, via the OpenAI-compatible
# /embeddings endpoint with `dimensions` truncation (gemini-embedding-001 supports 768/1536/3072).
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=768                # must match the vector(N) width in the migration
RAG_TOP_K=5                             # chunks retrieved per chat message
RAG_CHUNK_SIZE=1200                     # characters per text chunk before embedding
RAG_CHUNK_OVERLAP=200                   # character overlap between consecutive chunks
